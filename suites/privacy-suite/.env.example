# ── Required ──────────────────────────────────────────────────────────────────
# Domain for reverse proxy (used by network-toolkit to route traffic)
PRIVACY_DOMAIN=

# Admin password for AdGuard Home and WireGuard Easy web UI
ADGUARD_PASSWORD=

# ── Optional: Port overrides ─────────────────────────────────────────────────
# ADGUARD_PORT=80
# SEARXNG_PORT=8080
# VAULTWARDEN_PORT=8222
# WIREGUARD_PORT=51821

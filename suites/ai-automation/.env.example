# ── Required ──────────────────────────────────────────────────────────────────
# Domain for reverse proxy (used by network-toolkit to route traffic)
AI_AUTOMATION_DOMAIN=

# n8n encryption key for credential storage (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Flowise login password (generate with: openssl rand -hex 16)
FLOWISE_PASSWORD=

# ── Optional: n8n settings ────────────────────────────────────────────────────
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://ai.example.com/n8n/

# ── Optional: Ollama settings ─────────────────────────────────────────────────
# OLLAMA_KEEP_ALIVE=5m
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_EMBED_MODEL=nomic-embed-text   # RAG embedding model (see docs/rag-setup.md)

# ── Optional: Flowise settings ────────────────────────────────────────────────
# FLOWISE_USERNAME=admin

# ── Optional: Port overrides ──────────────────────────────────────────────────
# N8N_PORT=5678
# OLLAMA_PORT=11434
# QDRANT_PORT=6333
# FLOWISE_PORT=8150

# ── Optional: external proxy network ──────────────────────────────────────────
# MB_PROXY_NETWORK=mb-proxy

# ── Optional: Timezone ────────────────────────────────────────────────────────
# TIMEZONE=UTC

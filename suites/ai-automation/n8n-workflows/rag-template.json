        ]
      ]
    },
    "Embed Query": {
      "main": [
        [
          { "node": "Qdrant Search", "type": "main", "index": 0 }
        ]
      ]
    },
    "Qdrant Search": {
      "main": [
        [
          { "node": "Build Prompt", "type": "main", "index": 0 }
        ]
      ]
    },
    "Build Prompt": {
      "main": [
        [
          { "node": "LLM Generate", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {

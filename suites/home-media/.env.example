# ── Required ──────────────────────────────────────────────────────────────────
# Domain for reverse proxy (used by network-toolkit to route traffic)
MEDIA_DOMAIN=

# Immich database password (auto-generated if left empty during deploy)
IMMICH_DB_PASSWORD=

# ── Optional: Port overrides ─────────────────────────────────────────────────
# JELLYFIN_PORT=8096
# NAVIDROME_PORT=4533
# AUDIOBOOKSHELF_PORT=13378
# IMMICH_PORT=2283
# TRANSMISSION_PORT=9091
# BAZARR_PORT=6767

# ── Optional: Timezone ───────────────────────────────────────────────────────
# TIMEZONE=UTC

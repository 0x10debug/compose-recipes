# ---- Required ----
# Your public domain for the cloud suite (e.g. cloud.example.com)
CLOUD_DOMAIN=

# Nextcloud PostgreSQL database password
NEXTCLOUD_DB_PASSWORD=

# Nextcloud initial admin password
NEXTCLOUD_ADMIN_PASSWORD=

# OnlyOffice Document Server JWT secret (shared with Nextcloud connector)
ONLYOFFICE_JWT_SECRET=

# ---- Optional: port overrides ----
# NEXTCLOUD_PORT=8080
# ONLYOFFICE_PORT=8443
# FILEBROWSER_PORT=8081
# RADICALE_PORT=5232

# ---- Optional: external proxy network ----
# MB_PROXY_NETWORK=mb-proxy

# ---- Optional: Filebrowser UID/GID ----
# PUID=1000
# PGID=1000

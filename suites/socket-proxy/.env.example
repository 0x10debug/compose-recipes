# ── Socket-proxy network (optional override) ──────────────────────────────────
# The proxy lives on an internal Docker network so it is never reachable from
# the host or the public internet. This suite creates it automatically with
# internal: true. Other suites reference it as external.
# MB_SOCKET_PROXY_NETWORK=mb-socket-proxy

# ── Endpoint allowlist ────────────────────────────────────────────────────────
# Every endpoint defaults to 0 (denied). Set to 1 ONLY the ones a consumer
# actually needs. The socket-proxy blocks anything not listed here.
#
# Read-only endpoints (GET/HEAD). CONTAINERS=1 lets a consumer list and
# inspect containers; it does NOT allow create/kill/exec unless POST=1 too.
# Uncomment CONTAINERS=1 for the most common read-only use case (monitoring,
# container discovery, backup queries).
CONTAINERS=0
EXEC=0
IMAGES=0
INFO=0
NETWORKS=0
NODES=0
PLUGINS=0
SERVICES=0
SESSION=0
SWARM=0
SYSTEM=0
TASKS=0
VOLUMES=0

# Write endpoints (POST/PUT/DELETE). Keep these 0 unless a consumer must
# mutate Docker state. POST=1 combined with CONTAINERS=1 allows container
# create/kill/restart — enable deliberately and audit the resulting surface.
POST=0
BUILD=0
COMMIT=0
CONFIGS=0
DISTRIBUTION=0
EVENTS=0
SECRETS=0

# ── Required ──────────────────────────────────────────────────────────────────
# Domain for reverse proxy (used by network-toolkit to route traffic)
PRODUCTIVITY_DOMAIN=

# Outline database password (auto-generated if left empty during deploy)
OUTLINE_DB_PASSWORD=

# Outline secret key for session signing (generate with: openssl rand -hex 32)
OUTLINE_SECRET_KEY=

# Linkwarden database password (auto-generated if left empty during deploy)
LINKWARDEN_DB_PASSWORD=

# ── Optional: Port overrides ─────────────────────────────────────────────────
# VAULTWARDEN_PORT=8222
# MEMOS_PORT=5230
# OUTLINE_PORT=3000
# LINKWARDEN_PORT=3001
# STIRLING_PDF_PORT=8800

# ── Optional: Vaultwarden settings ───────────────────────────────────────────
# VAULTWARDEN_ADMIN_TOKEN=  # generate with: openssl rand -hex 32
# VAULTWARDEN_SIGNUPS_ALLOWED=false
# VAULTWARDEN_SHOW_PASSWORD_HINT=false

# ── Optional: Linkwarden settings ────────────────────────────────────────────
# LINKWARDEN_NEXTAUTH_SECRET=  # generate with: openssl rand -hex 32
# LINKWARDEN_DISABLE_REGISTRATION=true

# ── Optional: Timezone ───────────────────────────────────────────────────────
# TIMEZONE=UTC

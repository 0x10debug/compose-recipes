# ── Required ──────────────────────────────────────────────────────────────────
# Domain for reverse proxy (used by network-toolkit to route traffic)
DEV_DOMAIN=

# Gitea database password (auto-generated if left empty during deploy)
GITEA_DB_PASSWORD=

# Woodpecker CI database password (required when --profile ci is used)
WOODPECKER_DB_PASSWORD=

# Woodpecker OAuth credentials from Gitea (required when --profile ci is used)
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

# Code Server login password
CODE_SERVER_PASSWORD=

# ── Optional: Port overrides ─────────────────────────────────────────────────
# GITEA_WEB_PORT=3000
# GITEA_SSH_PORT=2222
# CODE_SERVER_PORT=8443
# WOODPECKER_PORT=8000
# REGISTRY_PORT=5000

# ── Optional: Timezone ───────────────────────────────────────────────────────
# TIMEZONE=UTC

# ── Optional: Reverse proxy network name ─────────────────────────────────────
# MB_PROXY_NETWORK=mb-proxy

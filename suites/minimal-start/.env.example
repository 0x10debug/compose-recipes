# ── Required ──────────────────────────────────────────────────────────────────
# Primary domain for the reverse proxy (Caddy serves HTTPS on this domain)
PRIMARY_DOMAIN=

# Beszel agent hub key (auto-generated if left empty during deploy)
# Get this from your Beszel hub instance when adding a new agent
BESZEL_HUB_KEY=

# ── Optional: Port overrides ─────────────────────────────────────────────────
# UPTIME_KUMA_PORT=3001
# BESZEL_AGENT_PORT=45876

# ── Optional: Beszel hub URL ──────────────────────────────────────────────────
# URL of your Beszel hub instance (required for the agent to connect)
# Can point to a hub on another server, e.g. https://beszel.example.com
# BESZEL_HUB_URL=https://beszel.example.com

# ── Optional: Timezone ───────────────────────────────────────────────────────
# TIMEZONE=UTC
